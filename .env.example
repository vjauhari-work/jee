# Copy to .env and replace every placeholder before starting the stack.
# The backend refuses to start with missing or known-weak secrets.

# MongoDB
MONGO_INITDB_ROOT_USERNAME=admin
# Generate with: openssl rand -hex 16
MONGO_INITDB_ROOT_PASSWORD=<generate-a-db-password>
MONGO_DB_NAME=jeeprep
MONGO_URI=mongodb://admin:<generate-a-db-password>@mongodb:27017/jeeprep?authSource=admin

# Backend
# Must be at least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=<generate-a-jwt-secret>
ADMIN_USERNAME=admin
# Minimum 8 characters; weak/common values are rejected.
ADMIN_PASSWORD=<choose-an-admin-password>
ADMIN_EMAIL=admin@jeeprep.local

# Comma-separated origins allowed to call the API cross-origin.
# Leave empty when nginx serves the frontend (same origin).
# For Vite dev mode use: http://localhost:5173
ALLOWED_ORIGINS=

# Set to true when serving over HTTPS so the auth cookie is
# only ever sent on encrypted connections.
COOKIE_SECURE=false

# mongo-express (debug profile only: docker compose --profile debug up -d)
ME_CONFIG_MONGODB_ADMINUSERNAME=admin
ME_CONFIG_MONGODB_ADMINPASSWORD=<generate-a-db-password>
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=<choose-a-mongo-express-password>
